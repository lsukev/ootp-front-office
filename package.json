{
  "name": "ootp-front-office",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "main": "build/main.cjs",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && NODE_ENV=production tsx server/index.ts",
    "check:theme": "tsx scripts/check-theme-contrast.ts",
    "check:stats": "tsx scripts/check-stats.ts",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run abi:electron && npm run desktop:build && electron .",
    "dist": "npm run abi:electron && npm run desktop:build && electron-builder",
    "dist:mac": "npm run abi:electron && npm run desktop:build && electron-builder --mac",
    "dist:win": "npm run abi:electron && npm run desktop:build && electron-builder --win",
    "abi:electron": "electron-builder install-app-deps",
    "abi:node": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.16.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "csv-parse": "^5.6.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
